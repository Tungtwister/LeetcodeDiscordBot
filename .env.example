# Copy this file to .env and fill in your real values. Do NOT put secrets in
# this file — .env is gitignored, .env.example is committed.

# From the Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Optional but strongly recommended. Right-click your server name -> Copy Server ID.
# Commands sync to this guild instantly; leaving it blank syncs globally, which can
# take up to an hour for changes to show up in the Discord client.
GUILD_ID=

# Right-click the channel you want daily reminders posted in -> Copy Channel ID
# (needs Developer Mode on in Discord: User Settings -> Advanced -> Developer Mode)
REMINDER_CHANNEL_ID=

# Comma-separated Discord user IDs of the people being tracked (right-click a user -> Copy User ID)
TRACKED_USER_IDS=

# IANA timezone, e.g. America/Los_Angeles, America/New_York. This sets both when the
# reminder fires AND where the day boundary falls for check-ins and streaks, so it
# must be the timezone you actually live in — not the server's.
APP_TIMEZONE=America/Los_Angeles

# 24-hour clock, in APP_TIMEZONE
REMINDER_HOUR=19
REMINDER_MINUTE=0

# Where the SQLite file lives. On Railway, point this at a mounted volume
# (e.g. /data/leetcode.db) so check-ins survive redeploys.
DB_PATH=leetcode.db
